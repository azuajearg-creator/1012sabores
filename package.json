{
  "name": "1012sabores",
  "version": "1.0.0",
  "description": "App de gestión para 1012Sabores - Comida Venezolana",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "test": "node --check main.js && node --check preload.js"
  },
  "build": {
    "appId": "com.1012sabores.app",
    "productName": "1012Sabores",
    "copyright": "1012Sabores - Comida Venezolana",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "firebase-config.js",
      "main.js",
      "preload.js",
      "build/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "1012Sabores"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7"
  },
  "private": true,
  "author": "Arnulfo José Azuaje Roa"
}
